# Frontend environment
#
# Empty (the default) means "use the Vite dev proxy": requests to /api are
# forwarded to http://127.0.0.1:8000 by vite.config.js. Recommended for local
# development because the browser never makes a cross-origin request.
#
# For a production build, point this at your deployed API, e.g.
# VITE_API_BASE_URL=https://reviewpilot-api.example.com
VITE_API_BASE_URL=
