# ---------------------------------------------------------------------------
# ReviewPilot environment variables
#
# Copy this file to `.env` in the same folder, then fill in the secrets:
#     cp .env.example .env          (macOS / Linux / Git Bash)
#     copy .env.example .env        (Windows cmd)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# NEVER commit `.env` to Git - it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (matches docker-compose.yml) ---------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# The "+psycopg" part selects the psycopg version 3 driver.
DATABASE_URL=postgresql+psycopg://reviewpilot:reviewpilot@localhost:5432/reviewpilot

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Set to true to run jobs inline in the API process (no worker needed).
# Only useful for quick local tests - it blocks the request until done.
CELERY_TASK_ALWAYS_EAGER=false

# --- GitHub ----------------------------------------------------------------
# The secret you typed into the webhook settings on GitHub. Used to verify
# that a webhook request really came from GitHub (HMAC-SHA256 signature).
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Fine-grained or classic token with "Contents: read" + "Pull requests: write"
# on the repo(s) you want to review.
GITHUB_TOKEN=

# --- OpenAI (review engine) -------------------------------------------------
OPENAI_API_KEY=
# Any chat-completions model works. gpt-4o-mini is cheap and good enough.
OPENAI_MODEL=gpt-4o-mini
# Optional: point at a compatible proxy / Azure-style gateway.
OPENAI_BASE_URL=

# --- OpenRouter (in-app assistant) -----------------------------------------
# Powers the chat bar. Separate key from the review engine on purpose.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. the following (cheap and fast):
CHAT_MODEL=openai/gpt-4o-mini
# Only change this if you proxy OpenRouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Behaviour -------------------------------------------------------------
# Post findings back to the Pull Request as inline comments?
POST_PR_COMMENTS=true
# Comma-separated list of allowed browser origins for CORS.
FRONTEND_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Diff text longer than this is truncated before being sent to the model.
MAX_DIFF_CHARS=40000
